.{
    .id = "com.metask.metawork.dev",
    .name = "metawork",
    .display_name = "MetaWork",
    .description = "A native workbench for structured agent sessions.",
    .version = "0.1.0",
    .platforms = .{"macos"},
    .permissions = .{ "window", "notifications" },
    .capabilities = .{ "webview", "js_bridge", "tray", "notifications" },
    .shortcuts = .{
        .{ .id = "settings.open", .key = ",", .modifiers = .{"primary"} },
    },
    .bridge = .{
        .commands = .{
            .{ .name = "metawork.smoke.ping", .origins = .{"zero://app"} },
            .{ .name = "metawork.smoke.eventAck", .origins = .{"zero://app"} },
            .{ .name = "metawork.events.connect", .origins = .{"zero://app"} },
            .{ .name = "metawork.events.disconnect", .origins = .{"zero://app"} },
            .{ .name = "metawork.window.beginDrag", .origins = .{"zero://app"} },
            .{ .name = "metawork.window.control", .origins = .{"zero://app"} },
            .{ .name = "metawork.window.state", .origins = .{"zero://app"} },
            .{ .name = "metawork.workspaces.choose", .origins = .{"zero://app"} },
            .{ .name = "metawork.workspaces.remove", .origins = .{"zero://app"} },
            .{ .name = "metawork.workspaces.refreshSkillCatalog", .origins = .{"zero://app"} },
            .{ .name = "metawork.skills.refreshCatalog", .origins = .{"zero://app"} },
            .{ .name = "metawork.skills.chooseImport", .origins = .{"zero://app"} },
            .{ .name = "metawork.skills.install", .origins = .{"zero://app"} },
            .{ .name = "metawork.skills.reimport", .origins = .{"zero://app"} },
            .{ .name = "metawork.skills.uninstall", .origins = .{"zero://app"} },
            .{ .name = "metawork.skills.retry", .origins = .{"zero://app"} },
            .{ .name = "metawork.skills.export", .origins = .{"zero://app"} },
            .{ .name = "metawork.skills.detail", .origins = .{"zero://app"} },
            .{ .name = "metawork.workbench.snapshot", .origins = .{"zero://app"} },
            .{ .name = "metawork.workbench.snapshot.chunk", .origins = .{"zero://app"} },
            .{ .name = "metawork.account.beginLogin", .origins = .{"zero://app"} },
            .{ .name = "metawork.account.reopenLogin", .origins = .{"zero://app"} },
            .{ .name = "metawork.account.reauthenticate", .origins = .{"zero://app"} },
            .{ .name = "metawork.account.cancelOperation", .origins = .{"zero://app"} },
            .{ .name = "metawork.account.refreshCatalog", .origins = .{"zero://app"} },
            .{ .name = "metawork.account.selectApiKey", .origins = .{"zero://app"} },
            .{ .name = "metawork.account.selectModel", .origins = .{"zero://app"} },
            .{ .name = "metawork.account.logout", .origins = .{"zero://app"} },
            .{ .name = "metawork.tasks.create", .origins = .{"zero://app"} },
            .{ .name = "metawork.tasks.run", .origins = .{"zero://app"} },
            .{ .name = "metawork.tasks.compact", .origins = .{"zero://app"} },
            .{ .name = "metawork.tasks.cancelCompact", .origins = .{"zero://app"} },
            .{ .name = "metawork.tasks.refreshSkillCatalog", .origins = .{"zero://app"} },
            .{ .name = "metawork.tasks.cancel", .origins = .{"zero://app"} },
            .{ .name = "metawork.tasks.respondUi", .origins = .{"zero://app"} },
            .{ .name = "metawork.tasks.close", .origins = .{"zero://app"} },
            .{ .name = "metawork.tasks.rename", .origins = .{"zero://app"} },
            .{ .name = "metawork.tasks.archive", .origins = .{"zero://app"} },
            .{ .name = "metawork.tasks.delete", .origins = .{"zero://app"} },
            .{ .name = "metawork.scheduledTasks.create", .origins = .{"zero://app"} },
            .{ .name = "metawork.scheduledTasks.update", .origins = .{"zero://app"} },
            .{ .name = "metawork.scheduledTasks.setEnabled", .origins = .{"zero://app"} },
            .{ .name = "metawork.scheduledTasks.runNow", .origins = .{"zero://app"} },
            .{ .name = "metawork.scheduledTasks.delete", .origins = .{"zero://app"} },
        },
    },
    .frontend = .{
        .dist = "frontend/dist",
        .entry = "index.html",
        .spa_fallback = true,
        .dev = .{
            .url = "http://127.0.0.1:5173/",
            .command = .{ "npm", "--workspace", "@metawork/renderer", "run", "dev", "--", "--host", "127.0.0.1" },
            .ready_path = "/",
            .timeout_ms = 30000,
        },
    },
    .security = .{
        .navigation = .{
            .allowed_origins = .{"zero://app"},
            .external_links = .{ .action = "deny" },
        },
    },
    .web_engine = "system",
    .windows = .{
        .{
            .label = "main",
            .title = "MetaWork",
            .width = 1180,
            .height = 760,
            .restore_state = true,
            .titlebar = "hidden_inset_tall",
            .close_policy = "hide",
        },
    },
}
