.{
    .id = "com.metask.metawork.dev",
    .name = "metawork",
    .display_name = "MetaWork",
    .description = "A native workbench for structured agent sessions.",
    .version = "0.2.3",
    .icons = .{
        "assets/icons/app-icon.png",
        "assets/icons/app-icon.ico",
    },
    .platforms = .{ "macos", "windows" },
    .permissions = .{ "window", "notifications" },
    .capabilities = .{ "webview", "js_bridge", "file_drops", "tray", "notifications" },
    .shortcuts = .{
        .{ .id = "settings.open", .key = ",", .modifiers = .{"primary"} },
    },
    .bridge = .{
        .commands = .{
            .{ .name = "metawork.smoke.ping", .origins = .{"zero://app"} },
            .{ .name = "metawork.smoke.eventAck", .origins = .{"zero://app"} },
            .{ .name = "metawork.events.connect", .origins = .{"zero://app"} },
            .{ .name = "metawork.events.disconnect", .origins = .{"zero://app"} },
            .{ .name = "metawork.host.windowChrome.connect", .origins = .{"zero://app"} },
            .{ .name = "metawork.host.windowChrome.refresh", .origins = .{"zero://app"} },
            .{ .name = "metawork.host.windowChrome.gesture", .origins = .{"zero://app"} },
            .{ .name = "metawork.host.windowChrome.control", .origins = .{"zero://app"} },
            .{ .name = "metawork.host.windowChrome.disconnect", .origins = .{"zero://app"} },
            .{ .name = "metawork.host.links.openExternal", .origins = .{"zero://app"} },
            .{ .name = "metawork.workspaces.choose", .origins = .{"zero://app"} },
            .{ .name = "metawork.workspaces.chooseAutomaticRoot", .origins = .{"zero://app"} },
            .{ .name = "metawork.workspaces.resetAutomaticRoot", .origins = .{"zero://app"} },
            .{ .name = "metawork.workspaces.retryAutomaticRoot", .origins = .{"zero://app"} },
            .{ .name = "metawork.workspaces.refreshSkillCatalog", .origins = .{"zero://app"} },
            .{ .name = "metawork.skills.refreshCatalog", .origins = .{"zero://app"} },
            .{ .name = "metawork.skills.setEnabled", .origins = .{"zero://app"} },
            .{ .name = "metawork.skills.setSourceEnabled", .origins = .{"zero://app"} },
            .{ .name = "metawork.skills.recoverSourceSettings", .origins = .{"zero://app"} },
            .{ .name = "metawork.skills.chooseImport", .origins = .{"zero://app"} },
            .{ .name = "metawork.skills.install", .origins = .{"zero://app"} },
            .{ .name = "metawork.skills.reimport", .origins = .{"zero://app"} },
            .{ .name = "metawork.skills.uninstall", .origins = .{"zero://app"} },
            .{ .name = "metawork.skills.retry", .origins = .{"zero://app"} },
            .{ .name = "metawork.skills.export", .origins = .{"zero://app"} },
            .{ .name = "metawork.skills.detail", .origins = .{"zero://app"} },
            .{ .name = "metawork.mcp.createStdioServer", .origins = .{"zero://app"} },
            .{ .name = "metawork.mcp.createHttpServer", .origins = .{"zero://app"} },
            .{ .name = "metawork.mcp.updateStdioConnection", .origins = .{"zero://app"} },
            .{ .name = "metawork.mcp.updateHttpConnection", .origins = .{"zero://app"} },
            .{ .name = "metawork.mcp.renameServer", .origins = .{"zero://app"} },
            .{ .name = "metawork.mcp.approveConnection", .origins = .{"zero://app"} },
            .{ .name = "metawork.mcp.captureSecret", .origins = .{"zero://app"} },
            .{ .name = "metawork.mcp.authorizeOAuth", .origins = .{"zero://app"} },
            .{ .name = "metawork.mcp.cancelAuthorization", .origins = .{"zero://app"} },
            .{ .name = "metawork.mcp.setServerEnabled", .origins = .{"zero://app"} },
            .{ .name = "metawork.mcp.setAllowedTools", .origins = .{"zero://app"} },
            .{ .name = "metawork.mcp.removeServer", .origins = .{"zero://app"} },
            .{ .name = "metawork.mcp.testConnection", .origins = .{"zero://app"} },
            .{ .name = "metawork.mcp.applyConfiguration", .origins = .{"zero://app"} },
            .{ .name = "metawork.mcp.refreshCatalog", .origins = .{"zero://app"} },
            .{ .name = "metawork.workbench.snapshot", .origins = .{"zero://app"} },
            .{ .name = "metawork.workbench.snapshot.chunk", .origins = .{"zero://app"} },
            .{ .name = "metawork.files.preview", .origins = .{"zero://app"} },
            .{ .name = "metawork.files.diff", .origins = .{"zero://app"} },
            .{ .name = "metawork.attachments.beginAdd", .origins = .{"zero://app"} },
            .{ .name = "metawork.attachments.appendAdd", .origins = .{"zero://app"} },
            .{ .name = "metawork.attachments.finishAdd", .origins = .{"zero://app"} },
            .{ .name = "metawork.attachments.cancelAdd", .origins = .{"zero://app"} },
            .{ .name = "metawork.attachments.choose", .origins = .{"zero://app"} },
            .{ .name = "metawork.attachments.addDropped", .origins = .{"zero://app"} },
            .{ .name = "metawork.attachments.beginReceive", .origins = .{"zero://app"} },
            .{ .name = "metawork.attachments.appendReceive", .origins = .{"zero://app"} },
            .{ .name = "metawork.attachments.finishReceive", .origins = .{"zero://app"} },
            .{ .name = "metawork.attachments.cancelReceive", .origins = .{"zero://app"} },
            .{ .name = "metawork.attachments.release", .origins = .{"zero://app"} },
            .{ .name = "metawork.account.beginLogin", .origins = .{"zero://app"} },
            .{ .name = "metawork.account.cancelOperation", .origins = .{"zero://app"} },
            .{ .name = "metawork.account.retryRefresh", .origins = .{"zero://app"} },
            .{ .name = "metawork.account.refreshSummary", .origins = .{"zero://app"} },
            .{ .name = "metawork.account.openRecharge", .origins = .{"zero://app"} },
            .{ .name = "metawork.account.logout", .origins = .{"zero://app"} },
            .{ .name = "metawork.models.refreshCatalog", .origins = .{"zero://app"} },
            .{ .name = "metawork.models.resetStore", .origins = .{"zero://app"} },
            .{ .name = "metawork.models.configureMetaskSelection", .origins = .{"zero://app"} },
            .{ .name = "metawork.models.selectDefault", .origins = .{"zero://app"} },
            .{ .name = "metawork.models.customProviders.create", .origins = .{"zero://app"} },
            .{ .name = "metawork.models.builtinProviders.create", .origins = .{"zero://app"} },
            .{ .name = "metawork.models.builtinProviders.updateBaseUrl", .origins = .{"zero://app"} },
            .{ .name = "metawork.models.customProviders.update", .origins = .{"zero://app"} },
            .{ .name = "metawork.models.customProviders.replaceCredential", .origins = .{"zero://app"} },
            .{ .name = "metawork.models.customProviders.remove", .origins = .{"zero://app"} },
            .{ .name = "metawork.models.customModels.test", .origins = .{"zero://app"} },
            .{ .name = "metawork.models.customModels.add", .origins = .{"zero://app"} },
            .{ .name = "metawork.models.customModels.replace", .origins = .{"zero://app"} },
            .{ .name = "metawork.models.customModels.remove", .origins = .{"zero://app"} },
            .{ .name = "metawork.tasks.create", .origins = .{"zero://app"} },
            .{ .name = "metawork.tasks.run", .origins = .{"zero://app"} },
            .{ .name = "metawork.tasks.setApprovalMode", .origins = .{"zero://app"} },
            .{ .name = "metawork.tasks.selectModel", .origins = .{"zero://app"} },
            .{ .name = "metawork.tasks.restore", .origins = .{"zero://app"} },
            .{ .name = "metawork.tasks.compact", .origins = .{"zero://app"} },
            .{ .name = "metawork.tasks.cancelCompact", .origins = .{"zero://app"} },
            .{ .name = "metawork.tasks.refreshSkillCatalog", .origins = .{"zero://app"} },
            .{ .name = "metawork.tasks.cancel", .origins = .{"zero://app"} },
            .{ .name = "metawork.tasks.respondUi", .origins = .{"zero://app"} },
            .{ .name = "metawork.tasks.rename", .origins = .{"zero://app"} },
            .{ .name = "metawork.tasks.archive", .origins = .{"zero://app"} },
            .{ .name = "metawork.tasks.markCompletionSeen", .origins = .{"zero://app"} },
            .{ .name = "metawork.tasks.delete", .origins = .{"zero://app"} },
            .{ .name = "metawork.tasks.recoverHistory", .origins = .{"zero://app"} },
            .{ .name = "metawork.scheduledTasks.create", .origins = .{"zero://app"} },
            .{ .name = "metawork.scheduledTasks.update", .origins = .{"zero://app"} },
            .{ .name = "metawork.scheduledTasks.setEnabled", .origins = .{"zero://app"} },
            .{ .name = "metawork.scheduledTasks.runNow", .origins = .{"zero://app"} },
            .{ .name = "metawork.scheduledTasks.delete", .origins = .{"zero://app"} },
            .{ .name = "metawork.scheduledTasks.recoverStore", .origins = .{"zero://app"} },
        },
    },
    .frontend = .{
        .dist = "frontend/dist",
        .entry = "index.html",
        .spa_fallback = true,
        .dev = .{
            .url = "http://127.0.0.1:5173/",
            .command = .{ "npm", "--workspace", "@metawork/renderer", "run", "dev", "--", "--host", "127.0.0.1" },
            .ready_path = "/",
            .timeout_ms = 30000,
        },
    },
    .security = .{
        .navigation = .{
            .allowed_origins = .{"zero://app"},
            .external_links = .{ .action = "deny" },
        },
    },
    .web_engine = "system",
    .windows = .{
        .{
            .label = "main",
            .title = "MetaWork",
            .width = 1180,
            .height = 760,
            .min_width = 320,
            .min_height = 520,
            .restore_state = true,
            .titlebar = "hidden_inset_tall",
            .close_policy = "hide",
        },
    },
}
