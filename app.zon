.{
    .id = "dev.metawork.desktop",
    .name = "metawork",
    .display_name = "MetaWork",
    .description = "A native workbench for structured agent sessions.",
    .version = "0.0.1",
    .platforms = .{"macos"},
    .permissions = .{"window"},
    .capabilities = .{ "webview", "js_bridge" },
    .bridge = .{
        .commands = .{
            .{ .name = "metawork.smoke.ping", .origins = .{"zero://app"} },
            .{ .name = "metawork.smoke.eventAck", .origins = .{"zero://app"} },
            .{ .name = "metawork.events.connect", .origins = .{"zero://app"} },
            .{ .name = "metawork.events.disconnect", .origins = .{"zero://app"} },
            .{ .name = "metawork.events.ack", .origins = .{"zero://app"} },
            .{ .name = "metawork.events.fetch", .origins = .{"zero://app"} },
            .{ .name = "metawork.workspace.choose", .origins = .{"zero://app"} },
            .{ .name = "metawork.workbench.snapshot", .origins = .{"zero://app"} },
            .{ .name = "metawork.workbench.snapshot.chunk", .origins = .{"zero://app"} },
            .{ .name = "metawork.sessions.create", .origins = .{"zero://app"} },
            .{ .name = "metawork.sessions.run", .origins = .{"zero://app"} },
            .{ .name = "metawork.sessions.cancel", .origins = .{"zero://app"} },
            .{ .name = "metawork.sessions.respondUi", .origins = .{"zero://app"} },
            .{ .name = "metawork.sessions.close", .origins = .{"zero://app"} },
        },
    },
    .frontend = .{
        .dist = "frontend/dist",
        .entry = "index.html",
        .spa_fallback = true,
        .dev = .{
            .url = "http://127.0.0.1:5173/",
            .command = .{ "npm", "--workspace", "@metawork/renderer", "run", "dev", "--", "--host", "127.0.0.1" },
            .ready_path = "/",
            .timeout_ms = 30000,
        },
    },
    .security = .{
        .navigation = .{
            .allowed_origins = .{"zero://app"},
            .external_links = .{ .action = "deny" },
        },
    },
    .web_engine = "system",
    .windows = .{
        .{
            .label = "main",
            .title = "MetaWork · Phase 0",
            .width = 1180,
            .height = 760,
            .restore_state = true,
        },
    },
}
